# ─── JWT & AUTH ────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=12h

# ─── DATABASE ──────────────────────────────────────────────
POSTGRES_USER=cafe_user
POSTGRES_PASSWORD=your-strong-database-password
POSTGRES_DB=cafe_payment
DATABASE_URL=postgresql://cafe_user:your-password@postgres:5432/cafe_payment

# ─── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── SERVER ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:3000

# ─── IYZICO PAYMENT GATEWAY ───────────────────────────────
IYZICO_API_KEY=sandbox-xxxxx-xxxxx-xxxxx
IYZICO_SECRET_KEY=sandbox-xxxxx-xxxxx-xxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:3000/api/payment/iyzico/callback

# ─── MONITORING & LOGGING ─────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
